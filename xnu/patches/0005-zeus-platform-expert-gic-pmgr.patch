+/* ---------------------------------------------------------------------- */
+
+class ZeusPMGR : public IOPMGR {
+	OSDeclareDefaultStructors(ZeusPMGR);
+
+public:
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	void enableCPUCore(unsigned int cpu_id, uint64_t entry_pa) APPLE_KEXT_OVERRIDE;
+	void disableCPUCore(unsigned int cpu_id) APPLE_KEXT_OVERRIDE;
+	void enableCPUCluster(unsigned int cluster_id) APPLE_KEXT_OVERRIDE;
+	void disableCPUCluster(unsigned int cluster_id) APPLE_KEXT_OVERRIDE;
+	void initCPUIdle(ml_processor_info_t *info) APPLE_KEXT_OVERRIDE;
+	void enterCPUIdle(UInt64 *newIdleTimeoutTicks) APPLE_KEXT_OVERRIDE;
+	void exitCPUIdle(UInt64 *newIdleTimeoutTicks) APPLE_KEXT_OVERRIDE;
+	void updateCPUIdle(UInt64 *newIdleTimeoutTicks) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(ZeusPMGR, IOPMGR);
+
+bool
+ZeusPMGR::start(IOService *provider)
+{
+	if (!IOPMGR::start(provider)) {
+		return false;
+	}
+	registerService();
+	IOLog("ZEUS PMGR: started (PSCI CPU_ON via SMC)\n");
+	return true;
+}
+
+void
+ZeusPMGR::enableCPUCore(unsigned int cpu_id, uint64_t entry_pa)
+{
+	const ml_topology_info_t *topo = ml_get_topology_info();
+	uint64_t mpidr = topo->cpus[cpu_id].phys_id;
+	int64_t ret = (int64_t)zeus_smc(PSCI_CPU_ON, mpidr, entry_pa, 0);
+	if (ret != PSCI_RET_SUCCESS && ret != PSCI_RET_ALREADY_ON) {
+		panic("ZEUS PMGR: PSCI CPU_ON cpu %u (MPIDR %llx) at %llx failed: %lld",
+		    cpu_id, mpidr, entry_pa, ret);
+	}
+}
+
+void
+ZeusPMGR::disableCPUCore(unsigned int /*cpu_id*/)
+{
+	/* the core powers itself off with PSCI CPU_OFF (arm64_prepare_for_sleep) */
+}
+
+void
+ZeusPMGR::enableCPUCluster(unsigned int /*cluster_id*/)
+{
+}
+
+void
+ZeusPMGR::disableCPUCluster(unsigned int /*cluster_id*/)
+{
+}
+
+void
+ZeusPMGR::initCPUIdle(ml_processor_info_t * /*info*/)
+{
+}
+
+void
+ZeusPMGR::enterCPUIdle(UInt64 *newIdleTimeoutTicks)
+{
+	if (newIdleTimeoutTicks != NULL) {
+		*newIdleTimeoutTicks = 0;
+	}
+}
+
+void
+ZeusPMGR::exitCPUIdle(UInt64 *newIdleTimeoutTicks)
+{
+	if (newIdleTimeoutTicks != NULL) {
+		*newIdleTimeoutTicks = 0;
+	}
+}
+
+void
+ZeusPMGR::updateCPUIdle(UInt64 *newIdleTimeoutTicks)
+{
+	if (newIdleTimeoutTicks != NULL) {
+		*newIdleTimeoutTicks = 0;
+	}
+}
+
+/* ---------------------------------------------------------------------- */
+
+class ZeusPlatformExpert : public IODTPlatformExpert {
+	OSDeclareDefaultStructors(ZeusPlatformExpert);
+
+public:
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	void processTopLevel(IORegistryEntry *root) APPLE_KEXT_OVERRIDE;
+	const char *deleteList(void) APPLE_KEXT_OVERRIDE;
+	const char *excludeList(void) APPLE_KEXT_OVERRIDE;
+	bool getTargetName(char *name, int maxLength) APPLE_KEXT_OVERRIDE;
+	bool getProductName(char *name, int maxLength) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(ZeusPlatformExpert, IODTPlatformExpert);
+
+template <class T>
+static void
+zeus_start_child(IOService *parent)
+{
+	T *child = new T;
+	if (child == NULL || !child->init() || !child->attach(parent) || !child->start(parent)) {
+		panic("ZEUS: cannot start %s", T::metaClass->getClassName());
+	}
+	child->release();
+}
+
+bool
+ZeusPlatformExpert::start(IOService *provider)
+{
+	IOLog("ZEUS: starting device-tree platform expert\n");
+	if (!IODTPlatformExpert::start(provider)) {
+		return false;
+	}
+	zeus_start_child<ZeusGIC>(this);
+	zeus_start_child<ZeusPMGR>(this);
+	registerService();
+	IOLog("ZEUS: platform expert registered\n");
+	return true;
+}
+
+const char *
+ZeusPlatformExpert::deleteList(void)
+{
+	return "()";
+}
+
+const char *
+ZeusPlatformExpert::excludeList(void)
+{
+	return "('chosen', 'defaults', 'cpus', 'options')";
+}
+
+void
+ZeusPlatformExpert::processTopLevel(IORegistryEntry *root)
+{
+	/*
+	 * The stock implementation requires an Apple NVRAM /options node; zeus
+	 * has none. Publish the CPU nubs (AppleARMSMP matches them by "reg") and
+	 * the other top-level nodes.
+	 */
+	IORegistryEntry *cpus = root->childFromPath("cpus", gIODTPlane);
+	if (cpus != NULL) {
+		createNubs(this, IODTFindMatchingEntries(cpus, kIODTExclusive, NULL));
+		cpus->release();
+	}
+	createNubs(this, IODTFindMatchingEntries(root, kIODTExclusive, excludeList()));
+}
+
+bool
+ZeusPlatformExpert::getTargetName(char *name, int maxLength)
+{
+	if (name == NULL || maxLength <= 0) {
+		return false;
+	}
+	strlcpy(name, "D83AP", (size_t)maxLength);
+	return true;
+}
+
+bool
+ZeusPlatformExpert::getProductName(char *name, int maxLength)
+{
+	if (name == NULL || maxLength <= 0) {
+		return false;
+	}
+	strlcpy(name, "iPhone16,1", (size_t)maxLength);
+	return true;
+}
+#endif /* ARM64_BOARD_CONFIG_ZEUS */
