+#include <arm64/zeus_early.h>
 #include <arm64/proc_reg.h>
 #include <arm64/lowglobals.h>
 #include <arm/cpu_data_internal.h>
@@ -1807,6 +1808,37 @@ init_ptpages(tt_entry_t *tt, vm_map_address_t start, vm_map_address_t end, bool
 #define ARM64_PHYSMAP_SLIDE_RANGE (1ULL << 30) // 1 GB
 #define ARM64_PHYSMAP_SLIDE_MASK  (ARM64_PHYSMAP_SLIDE_RANGE - 1)
 
+#if defined(ARM64_BOARD_CONFIG_ZEUS)
+/*
+ * zeus screen console: kernel VA aliases of the framebuffer and the MDSS
+ * block in the otherwise empty 32MB blocks above low globals and below
+ * gVirtBase (idea from ios-sweet patch 0012). They survive the bootstrap
+ * TTBR0 teardown and stay for the life of the kernel.
+ */
+#define ZEUS_FB_VA      (VM_MIN_KERNEL_ADDRESS + 1 * ARM_TT_L2_SIZE)
+#define ZEUS_MDSS_VA    (VM_MIN_KERNEL_ADDRESS + 2 * ARM_TT_L2_SIZE)
+
+static void
+zeus_map_block(vm_map_address_t va, uint64_t pa, uint64_t attrs)
+{
+	if (va + ARM_TT_L2_SIZE > gVirtBase) {
+		panic("zeus: console alias %llx overlaps the kernel", (unsigned long long)va);
+	}
+	tt_entry_t l1 = cpu_tte[(va & ARM_TT_L1_INDEX_MASK) >> ARM_TT_L1_SHIFT];
+	if ((l1 & (ARM_TTE_VALID | ARM_TTE_TYPE_MASK)) != (ARM_TTE_VALID | ARM_TTE_TYPE_TABLE)) {
+		panic("zeus: no L2 table for console alias %llx", (unsigned long long)va);
+	}
+	tt_entry_t *l2 = (tt_entry_t *)phystokv(l1 & ARM_TTE_TABLE_MASK);
+	tt_entry_t *slot = &l2[(va & ARM_TT_L2_INDEX_MASK) >> ARM_TT_L2_SHIFT];
+	if (*slot != ARM_TTE_EMPTY) {
+		panic("zeus: console alias %llx already in use", (unsigned long long)va);
+	}
+	*slot = pa | ARM_TTE_VALID | ARM_TTE_TYPE_BLOCK | ARM_TTE_BLOCK_AF |
+	    ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX | attrs;
+	__asm__ volatile ("dsb ishst" ::: "memory");
+}
+#endif /* ARM64_BOARD_CONFIG_ZEUS */
+
