index 6aa6fe4..e9389cb 100644
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -620,6 +620,27 @@ Lkernelcache_base_found:
 	lsr		x5,  x24, #(ARM_TT_L2_SHIFT)
 	create_bootstrap_mapping x14, x15, x5, x3, x2, x9, x10, x11, x12, x13
 
+#if defined(ARM64_BOARD_CONFIG_ZEUS)
+	/*
+	 * zeus screen console (zeus_early.c): the splash framebuffer (Normal
+	 * non-cacheable) and the MDSS register block (Device) as 32MB blocks in
+	 * the EXISTING V=P L2 table. With 16K pages one L1 entry spans 64GB, so
+	 * RAM (0x900000000), framebuffer and MDSS share L1 index 0 and its L2
+	 * table, which is the first one allocated: bootstrap_pagetables + 2 pages.
+	 */
+	add		x13, x25, #(2 * PGBYTES)
+	MOV64	x10, 0xb8000000
+	MOV64	x11, (ARM_TTE_TYPE_BLOCK | ARM_TTE_VALID | ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) | ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) | ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX)
+	orr		x11, x11, x10
+	lsr		x12, x10, #(ARM_TT_L2_SHIFT)
+	str		x11, [x13, x12, lsl #TTE_SHIFT]
+	MOV64	x10, 0x0a000000
+	MOV64	x11, (ARM_TTE_TYPE_BLOCK | ARM_TTE_VALID | ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_DISABLE) | ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX)
+	orr		x11, x11, x10
+	lsr		x12, x10, #(ARM_TT_L2_SHIFT)
+	str		x11, [x13, x12, lsl #TTE_SHIFT]
+#endif /* ARM64_BOARD_CONFIG_ZEUS */
+
 	/* Ensure TTEs are visible */
 	dsb		ish
 
diff --git a/osfmk/arm64/zeus_early.c b/osfmk/arm64/zeus_early.c
new file mode 100644
index 0000000..7a3dfd5
--- /dev/null
+++ b/osfmk/arm64/zeus_early.c
@@ -0,0 +1,200 @@
+/*
+ * Xiaomi 12 Pro (zeus) screen console. Ported from ios-sweet's sweet_early.c
+ * (xnu patches 0003/0010/0012), reworked for zeus:
+ *   - framebuffer: the ABL splash buffer, 1440x3200, 32 bpp, stride 5760
+ *   - the panel is a command-mode DSI panel: it only shows a new frame when
+ *     the display controller is told to send one, so every flush writes
+ *     CTL_0 START (the same kick the probe shim uses)
+ *
+ * No allocation, locks, ADT parsing or per-CPU state: this runs from the
+ * first line of arm_init (before the kernel collection is rebased, so no
+ * initialized data pointers) and from panic(). start.s maps the framebuffer
+ * (Normal non-cacheable) and the MDSS block (Device) VA=PA in the bootstrap
+ * TTBR0; arm_vm_init installs permanent kernel VA aliases and calls
+ * zeus_early_relocate() before TTBR0 goes away. The "zeus,fbcon" serial
+ * driver (pe_serial.c) prints through the same code afterwards.
+ */
+#include <arm64/zeus_early.h>
+
+#if defined(ARM64_BOARD_CONFIG_ZEUS)
+#include <stdbool.h>
+#include <stdint.h>
+#include <kern/misc_protos.h>
+
+#define FB_W            1440u
+#define FB_H            3200u
+#define FB_STRIDE_PX    (5760u / 4)
+#define SCALE           2u
+#define CELL_W          (8u * SCALE)
+#define CELL_H          (16u * SCALE)
+#define BAR_H           32u
+#define ROWS            ((FB_H - BAR_H) / CELL_H)
+#define COLS            (FB_W / CELL_W)
+#define FG              0xffffffffu
+#define BG              0xff000000u
+
+/* CTL_0 START inside the MDSS block mapped by start.s / arm_vm_init */
+#define CTL0_START_OFF  (0x0ae1601cULL - ZEUS_MDSS_BLOCK_PA)
+/* at most one frame per 20 ms (the panel runs at 60-120 Hz) */
+#define KICK_TICKS      (19200000ull / 50)
+
+extern unsigned char iso_font[256 * 16];
+
+/* Integers, not pointers: valid before the kernel collection is rebased. */
+static uintptr_t fb_va = ZEUS_FB_PA;
+static uintptr_t mdss_va = ZEUS_MDSS_BLOCK_PA;
+static unsigned int row, col, started, panicking;
+static uint64_t last_kick;
+
+static inline volatile uint32_t *
+fb_line(unsigned int y)
+{
+	return (volatile uint32_t *)(fb_va + (uintptr_t)y * FB_STRIDE_PX * 4);
+}
+
+static inline uint64_t
+ticks(void)
+{
+	__asm__ volatile ("isb" ::: "memory");
+	return __builtin_arm_rsr64("CNTVCT_EL0");
+}
+
+static void
+kick(bool wait)
+{
+	uint64_t now = ticks();
+
+	if (now - last_kick < KICK_TICKS) {
+		if (!wait) {
+			return;
+		}
+		while ((now = ticks()) - last_kick < KICK_TICKS) {
+		}
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	*(volatile uint32_t *)(mdss_va + CTL0_START_OFF) = 1;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	last_kick = now;
+}
+
+static void
+clear_row(unsigned int r)
+{
+	for (unsigned int y = r * CELL_H; y < (r + 1) * CELL_H; y++) {
+		volatile uint32_t *line = fb_line(y);
+		for (unsigned int x = 0; x < FB_W; x++) {
+			line[x] = BG;
+		}
+	}
+}
+
+static void
+newline(void)
+{
+	col = 0;
+	row = (row + 1) % ROWS;
+	clear_row(row);
+	clear_row((row + 1) % ROWS);	/* blank line marks the newest output */
+	kick(false);
+}
+
+void
+zeus_early_putc(char c)
+{
+	if (!started) {
+		started = 1;
+		clear_row(0);
+		clear_row(1);
+	}
+	if (c == '\r') {
+		col = 0;
+		return;
+	}
+	if (c == '\n') {
+		newline();
+		return;
+	}
+	if (col >= COLS) {
+		newline();
+	}
+	const unsigned char *glyph = iso_font + (unsigned char)c * 16;
+	for (unsigned int gy = 0; gy < 16; gy++) {
+		for (unsigned int sy = 0; sy < SCALE; sy++) {
+			volatile uint32_t *line = fb_line(row * CELL_H + gy * SCALE + sy) + col * CELL_W;
+			for (unsigned int gx = 0; gx < 8; gx++) {
+				uint32_t px = (glyph[gy] & (1u << gx)) ? FG : BG;
+				for (unsigned int sx = 0; sx < SCALE; sx++) {
+					line[gx * SCALE + sx] = px;
+				}
+			}
+		}
+	}
+	col++;
+}
+
+static void
+puts_early(const char *s)
+{
+	while (*s) {
+		zeus_early_putc(*s++);
+	}
+}
+
+void
+zeus_early_flush(void)
+{
+	kick(true);
+}
+
+/* Progress bar at the bottom (one coloured 40 px block per stage) + a text line. */
+void
+zeus_early_mark(unsigned int stage, const char *label)
+{
+	if (stage < FB_W / 40) {
+		uint32_t color = 0xff00ff00u | ((stage & 7u) * 32u << 16);
+		for (unsigned int y = FB_H - BAR_H; y < FB_H; y++) {
+			volatile uint32_t *line = fb_line(y);
+			for (unsigned int x = stage * 40; x < stage * 40 + 36; x++) {
+				line[x] = color;
+			}
+		}
+	}
+	puts_early("ZEUS ");
+	if (stage >= 10) {
+		zeus_early_putc((char)('0' + stage / 10 % 10));
+	}
+	zeus_early_putc((char)('0' + stage % 10));
+	puts_early(": ");
+	puts_early(label);
+	zeus_early_putc('\n');
+	kick(true);
+}
+
+void
+zeus_early_panic(const char *fmt, va_list *args)
+{
+	if (panicking) {
+		return;
+	}
+	panicking = 1;
+	puts_early("\nZEUS PANIC: ");
+	if (fmt != NULL && args != NULL) {
+		va_list copy;
+		va_copy(copy, *args);
+		_doprnt(fmt, &copy, zeus_early_putc, 16);
+		va_end(copy);
+	}
+	zeus_early_putc('\n');
+	kick(true);
+}
+
+void
+zeus_early_relocate(uint64_t fb, uint64_t mdss_block)
+{
+	zeus_early_mark(8, "leaving bootstrap TTBR0");
+	fb_va = (uintptr_t)fb;
+	mdss_va = (uintptr_t)mdss_block;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	zeus_early_mark(9, "kernel framebuffer alias live");
+}
+#endif /* ARM64_BOARD_CONFIG_ZEUS */
diff --git a/osfmk/arm64/zeus_early.h b/osfmk/arm64/zeus_early.h
new file mode 100644
index 0000000..379cc8d
--- /dev/null
+++ b/osfmk/arm64/zeus_early.h
@@ -0,0 +1,28 @@
+/* zeus screen console: bootstrap TTBR0 first, then permanent kernel VA aliases. */
+#ifndef _ARM64_ZEUS_EARLY_H_
+#define _ARM64_ZEUS_EARLY_H_
+
+#include <pexpert/arm64/board_config.h>
+#include <stdarg.h>
+#include <stdint.h>
+
+/* ABL splash framebuffer and the 32 MB block holding the MDSS (display) registers */
+#define ZEUS_FB_PA              0xb8000000ULL
+#define ZEUS_MDSS_BLOCK_PA      0x0a000000ULL
+
+#if defined(ARM64_BOARD_CONFIG_ZEUS)
+void zeus_early_mark(unsigned int stage, const char *label);
+void zeus_early_putc(char c);
+void zeus_early_flush(void);
+void zeus_early_panic(const char *fmt, va_list *args);
+void zeus_early_relocate(uint64_t fb, uint64_t mdss_block);
+#else
+static inline void
+zeus_early_mark(unsigned int stage, const char *label)
+{
+	(void)stage;
+	(void)label;
+}
+#endif
+
+#endif /* _ARM64_ZEUS_EARLY_H_ */
