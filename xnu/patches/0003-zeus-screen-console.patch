+	    ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) | ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB));
+	zeus_map_block(ZEUS_MDSS_VA, ZEUS_MDSS_BLOCK_PA, ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_DISABLE));
+#endif
 	arm_vm_physmap_init(args);
 	set_mmu_ttb_alternate(cpu_ttep & TTBR_BADDR_MASK);
 
 	ml_enable_monitor();
 
+#if defined(ARM64_BOARD_CONFIG_ZEUS)
+	/* final TTBR1 is live; move the console off the outgoing VA=PA mapping */
+	zeus_early_relocate(ZEUS_FB_VA, ZEUS_MDSS_VA);
+#endif
 	set_mmu_ttb(invalid_ttep & TTBR_BADDR_MASK);
 
 	flush_mmu_tlb();
+	zeus_early_mark(10, "TTBR0 off, TLB flushed");
 	kva_active = TRUE;
 	// global table pointers may need to be different due to physical aperture remapping
 	cpu_tte = (tt_entry_t*)(phystokv(cpu_ttep));
@@ -2265,7 +2308,9 @@ arm_vm_init(uint64_t memory_size, boot_args * args)
     }
 #endif
 #endif
