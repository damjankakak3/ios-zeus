+ * ADT: /defaults serial-device = phandle of a node with compatible "zeus,fbcon".
+ */
+static void
+zeus_fbcon_init(void)
+{
+}
+
+static unsigned int
+zeus_fbcon_transmit_ready(void)
+{
+	return 1;
+}
+
+static void
+zeus_fbcon_transmit_data(uint8_t c)
+{
+	zeus_early_putc((char)c);
+	if (c == '\n') {
+		zeus_early_flush();
+	}
+}
+
+static unsigned int
+zeus_fbcon_receive_ready(void)
+{
+	return 0;
+}
+
+static uint8_t
+zeus_fbcon_receive_data(void)
+{
+	return 0;
+}
+
+SECURITY_READ_ONLY_LATE(static struct pe_serial_functions) zeus_fbcon_serial_functions =
+{
+	.init = zeus_fbcon_init,
+	.transmit_ready = zeus_fbcon_transmit_ready,
+	.transmit_data = zeus_fbcon_transmit_data,
+	.receive_ready = zeus_fbcon_receive_ready,
+	.receive_data = zeus_fbcon_receive_data,
+	.device = SERIAL_ZEUS_FBCON
+};
+
+static void
+zeus_fbcon_setup(const DeviceTreeNode *const devicetree_node __unused)
+{
+	register_serial_functions(&zeus_fbcon_serial_functions);
+}
